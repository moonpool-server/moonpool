{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonpool.invalid/schema/request.schema.json",
  "title": "moonpool control request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "cmd", "args", "ts"],
  "properties": {
    "v": {"const": 1},
    "id": {"type": "string", "pattern": "^[0-9a-f]{16,64}$"},
    "cmd": {"type": "string", "enum": ["status", "players", "host", "receipt", "player", "bring", "save", "slots", "friend_code", "unlocks", "settings"]},
    "args": {"type": "object"},
    "ts": {"type": "number"}
  },
  "allOf": [
    {"if": {"properties": {"cmd": {"enum": ["status", "players", "host", "receipt", "save", "settings"]}}}, "then": {"properties": {"args": {"maxProperties": 0}}}},
    {"if": {"properties": {"cmd": {"const": "player"}}}, "then": {"properties": {"args": {"additionalProperties": false, "required": ["player", "command"], "properties": {"player": {"$ref": "#/$defs/text"}, "command": {"allOf": [{"$ref": "#/$defs/text"}, {"pattern": "^[^\\u0000-\\u001f;|`]+$"}]}}}}}},
    {"if": {"properties": {"cmd": {"const": "bring"}}}, "then": {"properties": {"args": {"additionalProperties": false, "required": ["player", "to"], "properties": {"player": {"$ref": "#/$defs/text"}, "to": {"$ref": "#/$defs/text"}}}}}},
    {"if": {"properties": {"cmd": {"const": "slots"}}}, "then": {"properties": {"args": {"additionalProperties": false, "required": ["slots"], "properties": {"slots": {"type": "number"}}}}}},
    {"if": {"properties": {"cmd": {"const": "friend_code"}}}, "then": {"properties": {"args": {"additionalProperties": false, "properties": {"force": {"type": "boolean"}}}}}},
    {"if": {"properties": {"cmd": {"const": "unlocks"}}}, "then": {"properties": {"args": {"additionalProperties": false, "properties": {"player": {"$ref": "#/$defs/text"}}}}}}
  ],
  "$defs": {"text": {"type": "string", "minLength": 1, "maxLength": 128}}
}
