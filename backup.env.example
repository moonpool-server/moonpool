# Copy this file to backup.env. It is read only by the backup container; keep
# game settings in .env. Uncomment one or more destinations and encryption.

# SSH/SFTP to another computer (use a password or mount a key separately).
# SSH_HOST_NAME=backup.example.net
# SSH_PORT=22
# SSH_USER=backups
# SSH_PASSWORD=replace-me
# SSH_REMOTE_PATH=/srv/backups/sn2
# SSH_HOST_PUBLIC_KEY=ssh-ed25519 AAAA... server.example.net

# S3-compatible storage. Backblaze B2: endpoint s3.<region>.backblazeb2.com.
# Cloudflare R2: endpoint <account-id>.r2.cloudflarestorage.com.
# AWS_S3_BUCKET_NAME=sn2-backups
# AWS_S3_PATH=world-one
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
# AWS_ENDPOINT=s3.us-west-004.backblazeb2.com
# AWS_ENDPOINT_PROTO=https

# Google Drive (share the destination folder with the service-account email).
# GOOGLE_DRIVE_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_DRIVE_FOLDER_ID=replace-me

# Dropbox app credentials and OAuth refresh token.
# DROPBOX_REMOTE_PATH=/sn2-backups
# DROPBOX_APP_KEY=replace-me
# DROPBOX_APP_SECRET=replace-me
# DROPBOX_REFRESH_TOKEN=replace-me

# WebDAV.
# WEBDAV_URL=https://storage.example.net/remote.php/dav/files/user
# WEBDAV_PATH=/sn2-backups/
# WEBDAV_USERNAME=replace-me
# WEBDAV_PASSWORD=replace-me

# Encrypt archives before writing any configured destination (choose one).
# GPG_PASSPHRASE=replace-with-a-long-random-passphrase
# AGE_PASSPHRASE=replace-with-a-long-random-passphrase

# Advanced offen pruning controls. Remote and local age pruning use
# BACKUP_RETENTION_DAYS from .env unless a backend is excluded here.
# BACKUP_SKIP_BACKENDS_FROM_PRUNE=
# BACKUP_PRUNING_LEEWAY=1m
