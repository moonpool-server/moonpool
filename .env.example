# Copy to .env next to compose.yaml and edit. Never commit .env.
# No Steam password or Steam Guard code belongs here: sign the Windows Steam
# client in once on the web desktop (docs/operating.md).

# An image you built elsewhere. Empty keeps the local Dockerfile build.
# SN2_IMAGE=

# Headless windows are always backgrounded; cap that path without changing other graphics settings.
SERVER_MAX_FPS=60


# Host-side port for the noVNC viewer. The viewer starts with the container in
# every mode and is restarted if it dies.
NOVNC_PORT=8080

# Interface the viewer listens on. It controls the signed-in Steam, so it stays local
# by default: reach it with ssh -L 8080:127.0.0.1:8080 you@server. 0.0.0.0 opens it to
# your LAN, where a VNC password is thin protection, so prefer the ssh tunnel. Never
# forward this port from the internet.
VIEWER_BIND=127.0.0.1

# The viewer always asks for a password. Leave this empty and one is made at first start,
# shown by `bin/moonpool diag viewer`; set it to choose your own.
VNC_PASSWORD=

# Interface for the join page and mod files on SN2_MODS_PORT. Players without a tunnel
# reach it directly so it listens everywhere. 127.0.0.1 with TUNNEL=quick.
MODS_BIND=0.0.0.0

# friends keeps this recipe's current behavior; stock uses the game's player
# cap and turns off progression help and idle clock freezing. Uncomment any
# setting below to override that one preset choice.
PRESET=friends
# 4 is the game's own limit. More works by raising the session limit but is less proven.
# PLAYER_SLOTS=4
# Comma-separated Epic (EOS) IDs, the 32 hex characters the UE4SS log prints as each player
# joins ("player NAME eos=..."). Names and Steam IDs are ignored. Empty means nobody may run commands
# by renaming a PDA signal.
# ADMINS=
# ADMIN_PREFIX=!
# STORY_GOALS=true
# UNLOCK_REPLAY=true
# LIFEPOD_JOIN_HOLD=true
# VOICE_WARN=true
# VOICE_RANGE_M=100
# IDLE_FREEZE_MINUTES=10
# IDLE_STOP_HOURS=

# Headless-host necessities, on under both presets: the host leaves the player list and its
# body is hidden. Switch one off only to rule it out (docs/operating.md, Diagnostic switches).
HOST_PRUNE=true
HIDE_HOST_BODY=true

# Milliseconds between the Unlock lines sent to a joiner (10..2000); a 20 ms burst froze a
# client's toolbar.
UNLOCK_INTERVAL_MS=50
# Save to host on start; empty = the newest save, or a new world if none.
SAVE_NAME=
# 1 = the host accepts friend requests from people you invited within a minute:
# `moonpool players invite <steamid64|profile link>`. 0 = accept by hand on the viewer page.
# It does that with the Steam client's own web session, read from its cookie store in the
# data volume, and talks to Steam as the host account; the same session reads the lobby id.
AUTO_ACCEPT_FRIENDS=1
# Steam persona the host account shows to players. Never your own name.
HOST_NAME=SN2 Host
# public | experimental. Everyone joining must be on the same branch.
STEAM_BRANCH=public
# Only for a password-locked beta; handed to Steam once in a steam:// link, which other
# processes in the container can see, and never stored by us.
STEAM_BRANCH_PASSWORD=

# Read-only signed player mod downloads. Use a tunnel or an HTTPS proxy, then set
# the exact address players can reach: https://, or http:// only on a private
# network, because players run the launcher from it. Empty URL keeps Discord quiet.
SN2_MODS_PORT=8081
# A page at /map charting where players have been, plus a Map button on the Discord
# card. No names, and each square appears MAP_DELAY_MINUTES after it was first visited,
# but anyone with the link can see bases and explored areas. Off by default.
WEB_MAP=false
# MAP_DELAY_MINUTES=15
SN2_PUBLIC_URL=
# off: no public address. quick: start with --profile tunnel for a temporary
# HTTPS address. token: start with --profile tunnel-token and set both values below.
TUNNEL=off
# Read by cloudflared from its environment, never on its command line.
TUNNEL_TOKEN=
# Your own CurseForge API key, for mods declared by CurseForge project in control/plugins.yaml.
# Used only by the server's mod publisher, never sent to players. Empty skips those mods.
CURSEFORGE_API_KEY=
# Game executables (full sha256, comma-separated) the player launcher may put the UE4SS
# loader beside, besides the host's own build, which is always allowed.
CLIENT_BUILDS=
# Backups: schedule, age retention, local archive folder, duplicate suppression,
# and optional local size cap. Remote credentials belong in backup.env instead.
BACKUP_CRON=*/30 * * * *
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=./backups
BACKUP_SKIP_UNCHANGED=true
BACKUP_MAX_TOTAL_MB=
# What players see: HOST_NAME (the host account in the friend list), WORLD_NAME
# (the session and the save), SAVE_NAME (the save slot; empty = the newest).
WORLD_NAME=Subnautica 2 server
# MOTD: a short greeting each player gets once on joining (200 characters at most); empty sends none.
# MOTD=
# A line of your own on the Discord card, under the steps to join.
# DISCORD_CARD_NOTE=

# The Windows Steam installer runs only with Valve's signature verified against the
# system's roots. true skips that check, said in the log.
# STEAM_SETUP_UNVERIFIED=false

# The loader. auto (default) = upstream-experimental, build 1190, which reads UE 5.6
# itself (proven on the public branch). It changes to pinned, UE4SS build 1188, only
# if you supply your own layout set for this exact executable in ue4ss-layouts in the
# data volume. None ship with this project.
# Each channel pins its asset by SHA-256.
UE4SS_CHANNEL=auto
# Overrides for another build: set both together, or neither.
# UE4SS_ASSET=
# UE4SS_RELEASE_SHA256=

# true: ask Steam to validate and update the game on each container start.
AUTO_UPDATE=true

# Player privacy on Discord. Names are shown by
# default; false numbers them ("Player 1").
SHOW_PLAYER_NAMES=true
# Optional role id mentioned only for scheduled restart, update, and outage alerts.
DISCORD_ALERT_ROLE_ID=
# Other worlds' panels on this world's card, as space-separated card.json addresses
# e.g. http://host.docker.internal:8091/card.json
# Each of those worlds needs PUBLISH_CARD=true or its panel here says Offline.
# DISCORD_BOARD_PEERS=
# Publish /card.json on the web port so another world's board can show this one. It holds
# what the card shows, player names included when SHOW_PLAYER_NAMES is true, to anyone who
# can reach the port. Off unless set.
# PUBLISH_CARD=true
# The channel webhook the card is posted through (channel settings > Integrations >
# Webhooks). A secret: anyone holding it can post there.
DISCORD_WEBHOOK_URL=
# Optional one-time channel setup (`bin/moonpool discord setup`). The bot needs
# Manage Channels and Manage Roles, only during that command; take the token out of .env
# afterwards, the running host never reads it.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Empty server: the game keeps running so joins are instant. After this many
# minutes with nobody in, the in-game clock is frozen until the next join (0 = off).
# Optional: stop the game after this many hours empty (saves power; the next
# join then waits for `moonpool server start` or RESTART_CRON). Empty = never.
# Scheduled restart cron expression. Empty = off.
RESTART_CRON=
# Warn online players before a planned stop or restart, then wait this long for
# the forced save's completion line. Docker waits STOP_GRACE_PERIOD in all: keep it
# at least their sum plus 60 s (120 + 60 + 60 = 240).
RESTART_WARNING_SECONDS=120
RESTART_SAVE_WAIT_SECONDS=60
STOP_GRACE_PERIOD=240s

# true: press Host by itself once the lobby is reached. false: wait for `moonpool server arm`.
# AUTO_HOST=true
# true: only people you invited can become friends of the host. Existing Steam friends can
# still join: remove them with `moonpool ban add`. false: anyone who finds its profile gets in
# (PLAYER_SLOTS still caps). The ban list always wins.
# ALLOWLIST_ONLY=true
