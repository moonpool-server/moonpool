{
  "_about": "The in-game admin console's words, shortcuts and replies. A host overrides any of it with console.json in the data volume; a key left out keeps the value here. Nothing a player reads is written in the code.",
  "signal_word": "mp",
  "line_gap_ms": 1000,
  "reply_seconds": 8,
  "reply_on_run": false,
  "cheat_gap_s": 1,
  "cheat_per_sender": 12,
  "target_mark": "@",
  "player_arg": "[player]",
  "targets": {
    "all": [
      "all",
      "everyone"
    ],
    "host": [
      "host"
    ],
    "me": [
      "me"
    ]
  },
  "max_lines": 12,
  "undo": {
    "verbs": [
      "spawn",
      "summon"
    ],
    "keep": 10,
    "within_m": 100
  },
  "cheat_prefix": "Cheat.",
  "tags": [
    "Cheat.UnlockRecipes",
    "Cheat.InfiniteKnowledge",
    "Cheat.AllBioAbilities",
    "Cheat.FreeBuild",
    "Cheat.NoSuffocate",
    "Cheat.NoStarve",
    "Cheat.NoDehydrate",
    "Cheat.FastBuild",
    "Cheat.NoCost",
    "Cheat.UnlimitedPower",
    "Cheat.UnlimitedBattery",
    "Cheat.UnlimitedHealth",
    "Cheat.GodMode",
    "Cheat.Invisible",
    "Cheat.Fly",
    "Cheat.NoClip"
  ],
  "cheat_channel": "GameplayMessage.Cheat",
  "cheat_message_pattern": "String=\"(.-)\"",
  "blocked_channel": "None",
  "on_gate_failure": "kick",
  "resolve_kinds": [
    "items"
  ],
  "kinds": {
    "items": {
      "aliases": [
        "items"
      ]
    },
    "players": {
      "aliases": [
        "players"
      ]
    },
    "commands": {
      "aliases": [
        "commands"
      ]
    },
    "tags": {
      "aliases": [
        "tags"
      ]
    }
  },
  "verbs": {
    "find": [
      "find"
    ],
    "ls": [
      "list"
    ],
    "who": [
      "who"
    ],
    "cheats": [
      "cheats"
    ],
    "help": [
      "help"
    ],
    "undo": [
      "undo"
    ]
  },
  "commands": {
    "give": {
      "aliases": [
        "give"
      ],
      "lines": [
        "Give {item} {count}"
      ],
      "args": [
        {
          "name": "item",
          "kind": "items"
        },
        {
          "name": "count",
          "default": "1"
        }
      ]
    },
    "heal": {
      "aliases": [
        "heal"
      ],
      "lines": [
        "HealMe",
        "attr oxygen 100",
        "attr food 100",
        "attr water 100"
      ]
    },
    "tag": {
      "aliases": [
        "tag"
      ],
      "lines": [
        "AddGlobalTag {tag}"
      ],
      "args": [
        {
          "name": "tag",
          "kind": "tags"
        }
      ]
    },
    "untag": {
      "aliases": [
        "untag"
      ],
      "lines": [
        "RemoveGlobalTag {tag}"
      ],
      "args": [
        {
          "name": "tag",
          "kind": "tags"
        }
      ]
    },
    "normal": {
      "aliases": [
        "normal"
      ],
      "lines": [
        "DayOnly 0",
        "RemoveGlobalTag Cheat.UnlockRecipes",
        "RemoveGlobalTag Cheat.InfiniteKnowledge",
        "RemoveGlobalTag Cheat.AllBioAbilities",
        "RemoveGlobalTag Cheat.FreeBuild",
        "RemoveGlobalTag Cheat.NoSuffocate",
        "RemoveGlobalTag Cheat.NoStarve",
        "RemoveGlobalTag Cheat.NoDehydrate",
        "RemoveGlobalTag Cheat.FastBuild",
        "RemoveGlobalTag Cheat.NoCost",
        "RemoveGlobalTag Cheat.UnlimitedPower",
        "RemoveGlobalTag Cheat.UnlimitedBattery",
        "RemoveGlobalTag Cheat.UnlimitedHealth",
        "RemoveGlobalTag Cheat.GodMode",
        "RemoveGlobalTag Cheat.Invisible",
        "RemoveGlobalTag Cheat.Fly",
        "RemoveGlobalTag Cheat.NoClip"
      ]
    }
  },
  "deny": [
    "crashserver*",
    "crashclient*",
    "clearsaves",
    "newgameofmode",
    "destroyall*",
    "destroypawns",
    "forceprocessexit",
    "forcequickprocessexit",
    "killall",
    "killallofclass",
    "kill_player*",
    "togglesaveblocking",
    "executeforall",
    "runmacro"
  ],
  "messages": {
    "help": "give [player] <item> [count] | heal [player|all] | who | find <text> | list <kind> [text] | cheats | undo | tag <tag> | untag <tag> | normal | any console line",
    "find_row": "{kind}: {name} = {id}",
    "find_none": "Nothing matches {query}",
    "ls_row": "{name} = {id}",
    "ls_none": "No {kind} match {query}",
    "ls_kinds": "ls needs one of: {kinds}",
    "who_row": "{name}  eos {eos}  {ping} ms",
    "who_none": "Nobody else is on",
    "cheats_row": "{tag}",
    "cheats_none": "No cheats are on",
    "cheats_unknown": "The game's world tags can't be read right now",
    "no_match": "No {kind} matches {query}",
    "no_player": "No player matches {query}",
    "missing_arg": "use: {usage}",
    "denied": "{word} is on the deny list (console.json)",
    "chained": "One command per line: no ; | ` or line breaks",
    "ran": "{count} line(s) for {players}: {lines}",
    "more": "... and {count} more",
    "console_off": "The console is off: add player to enabled_commands in sn2headless.json",
    "choose": "{query}? {choices}",
    "no_choice": "Pick 1 to {count}",
    "ambiguous": "{query} could be: {matches}",
    "undo_none": "Nothing of yours to undo",
    "undo_done": "Removed {name}, {meters} m away",
    "undo_gone": "No {name} within {meters} m"
  },
  "on_ambiguous": "ask",
  "max_choices": 6
}
