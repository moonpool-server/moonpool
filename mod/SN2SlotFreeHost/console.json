{
  "_about": "The in-game admin console's words, shortcuts and replies. A host overrides any of it with console.json in the data volume; a key left out keeps the value here. Nothing a player reads is written in the code.",
  "signal_word": "mp",
  "line_gap_ms": 1000,
  "reply_seconds": 8,
  "target_mark": "@",
  "targets": {
    "all": [
      "all",
      "*"
    ],
    "host": [
      "host"
    ],
    "me": [
      "me"
    ]
  },
  "repeat": [
    "."
  ],
  "max_lines": 12,
  "cheat_prefix": "Cheat.",
  "resolve_kinds": [
    "items",
    "places"
  ],
  "kinds": {
    "items": {
      "aliases": [
        "i",
        "item",
        "items"
      ]
    },
    "places": {
      "aliases": [
        "p",
        "place",
        "places"
      ]
    },
    "players": {
      "aliases": [
        "pl",
        "player",
        "players"
      ]
    },
    "commands": {
      "aliases": [
        "cmd",
        "command",
        "commands"
      ]
    },
    "tags": {
      "aliases": [
        "t",
        "tag",
        "tags"
      ]
    }
  },
  "verbs": {
    "find": [
      "f",
      "find",
      "?"
    ],
    "ls": [
      "l",
      "ls",
      "list"
    ],
    "who": [
      "w",
      "who"
    ],
    "cheats": [
      "c",
      "cheats"
    ],
    "help": [
      "help",
      "h?"
    ]
  },
  "commands": {
    "give": {
      "aliases": [
        "g",
        "give"
      ],
      "lines": [
        "Give {item} {count}"
      ],
      "args": [
        {
          "name": "item",
          "kind": "items"
        },
        {
          "name": "count",
          "default": "1"
        }
      ]
    },
    "heal": {
      "aliases": [
        "h",
        "heal"
      ],
      "lines": [
        "HealMe",
        "attr oxygen 100",
        "attr food 100",
        "attr water 100"
      ]
    },
    "tag": {
      "aliases": [
        "tag+"
      ],
      "lines": [
        "AddTag {tag}"
      ],
      "args": [
        {
          "name": "tag",
          "kind": "tags"
        }
      ]
    },
    "untag": {
      "aliases": [
        "tag-"
      ],
      "lines": [
        "RemoveTag {tag}"
      ],
      "args": [
        {
          "name": "tag",
          "kind": "tags"
        }
      ]
    },
    "tadpole": {
      "aliases": [
        "tadpole"
      ],
      "lines": [
        "Give DA_TitaniumIngot_ItemType 2",
        "Give DA_Glass_ItemType 1",
        "Give DA_ComputerChip_ItemType 1",
        "Give DA_PowerCell_ItemType 1"
      ]
    },
    "upgrades": {
      "aliases": [
        "upgrades"
      ],
      "lines": [
        "Give DA_Tadpole_HullReinforcement_ItemType 1",
        "Give DA_Tadpole_EngineEfficiency_ItemType 1",
        "Give DA_Tadpole_EchoLocation_ItemType 1",
        "Give DA_Tadpole_CrushDepthUpgrade02_ItemType 1",
        "Give DA_Tadpole_HydraulicMuffler_ItemType 1",
        "Give DA_Tadpole_Leapfrog_ItemType 1",
        "Give DA_Tadpole_PhotovoltaicCharger_ItemType 1"
      ]
    },
    "materials": {
      "aliases": [
        "materials"
      ],
      "lines": [
        "Give DA_Titanium_ItemType 20",
        "Give DA_Copper_ItemType 20",
        "Give DA_Quartz_ItemType 20",
        "Give DA_Lead_ItemType 10",
        "Give DA_Silver_ItemType 10",
        "Give DA_Gold_ItemType 10"
      ]
    },
    "power": {
      "aliases": [
        "power"
      ],
      "lines": [
        "Give DA_PowerCell_ItemType 5",
        "Give DA_BasicBattery_ItemType 5"
      ]
    },
    "unlock": {
      "aliases": [
        "unlock"
      ],
      "lines": [
        "UnlockAllRecipes",
        "UnlockAllDatabank"
      ]
    },
    "freebuild": {
      "aliases": [
        "freebuild"
      ],
      "lines": [
        "AddTag Cheat.FreeBuild",
        "AddTag Cheat.UnlockRecipes"
      ]
    },
    "nofreebuild": {
      "aliases": [
        "nofreebuild"
      ],
      "lines": [
        "RemoveTag Cheat.FreeBuild"
      ]
    }
  },
  "deny": [
    "crashserver*",
    "crashclient*",
    "clearsaves",
    "newgameofmode",
    "destroyallactorsofclass",
    "forceprocessexit",
    "forcequickprocessexit",
    "killall",
    "killallofclass",
    "kill_player*",
    "togglesaveblocking"
  ],
  "messages": {
    "help": "mp [@who] <console line> | find <text> | ls <kind> [text] | who | cheats | . repeats | shortcuts: {shortcuts}",
    "find_row": "{kind}: {name} = {id}",
    "find_none": "Nothing matches {query}",
    "ls_row": "{name} = {id}",
    "ls_none": "No {kind} match {query}",
    "ls_kinds": "ls needs one of: {kinds}",
    "who_row": "{name}  eos {eos}  {ping} ms",
    "who_none": "Nobody else is on",
    "cheats_row": "{tag}",
    "cheats_none": "No cheats are on",
    "cheats_unknown": "The game's world tags can't be read yet",
    "no_match": "No {kind} matches {query}",
    "no_player": "No player matches {query}",
    "missing_arg": "{command} needs {arg}",
    "denied": "{word} is on the deny list (console.json)",
    "ran": "{count} line(s) for {players}: {lines}",
    "no_last": "Nothing to repeat yet",
    "more": "... and {count} more",
    "console_off": "The console is off: add player to enabled_commands in sn2headless.json",
    "choose": "{query}? {choices}",
    "no_choice": "Pick 1 to {count}",
    "ambiguous": "{query} could be: {matches}"
  },
  "on_ambiguous": "ask",
  "max_choices": 6
}
