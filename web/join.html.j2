<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
{%- if refresh %}<meta http-equiv="refresh" content="{{ refresh }}">{% endif -%}
<title>Join {{ world }}</title><style>
:root{color-scheme:dark;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;background:#071923;color:#eaf7fb}body{margin:0;min-height:100vh;display:grid;place-items:center}.card{width:min(34rem,calc(100% - 3rem));padding:2.5rem;border:1px solid #286174;border-radius:18px;background:#0c2835;box-shadow:0 20px 60px #0008;text-align:center}h1{margin:0 0 1rem;font-size:clamp(1.8rem,6vw,2.7rem)}.lead{font-size:1.2rem}.button{display:block;margin:1.8rem auto;padding:1rem 1.4rem;border-radius:10px;background:#39b7d5;color:#04141c;font-weight:750;font-size:1.25rem;text-decoration:none}.button:hover{background:#70d5eb}.friend{margin-top:2rem;color:#b9d6df}a{color:#7bdcf2}.ghost{background:transparent;border:2px solid #39b7d5;color:#9fe4f5;font-size:1.05rem;padding:.8rem 1.2rem}.ghost:hover{background:#0e3647}.opt{margin-top:2.2rem;padding-top:1.4rem;border-top:1px solid #1d4a5a}.fine{font-size:.95rem;color:#9fb9c3;margin:.4rem 0 0}.mods{text-align:left;margin:.4rem 0 0;padding-left:1.2rem}.mods li{margin:.3rem 0;color:#cfe6ee}.close{margin-top:1.5rem;padding:.6rem 1.1rem;border:1px solid #286174;border-radius:8px;background:transparent;color:#b9d6df;font:inherit;cursor:pointer}.close:hover{color:#eaf7fb;border-color:#39b7d5}</style></head>
<body><main class="card"><h1>Join {{ world }}</h1>
{%- if branch or build %}<p class="fine">{{ branch_label }} branch{% if build %} &middot; build {{ build }}{% endif %}{% if branch != "public" %} &middot; in Steam, set Subnautica 2 &rsaquo; Properties &rsaquo; Betas to <strong>{{ branch }}</strong> first{% endif %}</p>{% endif -%}
{%- if not join %}<p class="lead">The server is starting.</p><p>This page will be ready as soon as the world is open. Try again in a minute.</p>
{%- elif mods_published %}{{ modnote|safe }}<p class="fine"><a href="{{ join }}">Join without mods</a> &middot; Not friends with the host? <a href="{{ friend }}">Add them</a> first.</p>
{%- else %}<div id="handoff"><p class="lead" id="lead">Opening Subnautica 2 through Steam…</p><a class="button" href="{{ join }}">Join now</a><p>If nothing happens, use the button above. First time? Tick <strong>Always allow</strong> on the browser&rsquo;s &ldquo;Open Steam?&rdquo; prompt so later joins take one click.</p>{{ modnote|safe }}<p class="friend">Not friends with the host yet? <a href="{{ friend }}">open the host&rsquo;s Steam profile</a> and send a request first.</p><p><button class="close" id="close" type="button" hidden>Close this tab</button></p></div><script>(function(){var c=document.getElementById("close");c.onclick=function(){window.close()};setTimeout(function(){document.getElementById("lead").innerHTML="Launching Subnautica 2 &middot; you can close this tab";c.hidden=false},4000);document.addEventListener("visibilitychange",function(){if(document.hidden){window.close()}})})()</script>
{%- endif %}</main></body></html>
