<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
{%- if refresh %}<meta http-equiv="refresh" content="{{ refresh }}">{% endif -%}
<title>Join {{ world }} · {{ game }}</title><meta property="og:title" content="Join {{ world }} · {{ game }}"><meta property="og:type" content="website"><link rel="icon" href="data:,"><link rel="stylesheet" href="theme.css?{{ theme }}"><style>
html{background:var(--ink);color:var(--text);font:var(--size-body)/var(--leading) var(--font-text)}
body{margin:0;min-height:100vh;padding:var(--pad);box-sizing:border-box;--pad:clamp(var(--gap-4),4vw,var(--gap-6))}
*,*::before,*::after{box-sizing:inherit}
.page{display:grid;gap:var(--gap-5);max-width:var(--join-column);margin:0 auto;grid-template-areas:"head" "act" "map" "mods"}
.page.with-map{max-width:var(--page-max)}
@media (min-width:62rem){
  .page.with-map{grid-template-columns:minmax(0,var(--join-column)) minmax(0,1fr);grid-template-rows:auto auto 1fr;column-gap:var(--gap-6);grid-template-areas:"head map" "act map" "mods map"}
  .page.with-map .mapbox{position:sticky;top:var(--pad);height:calc(100vh - 2 * var(--pad));align-self:start}
}
.head{grid-area:head;min-width:0}.act{grid-area:act;min-width:0}.mods-box{grid-area:mods;min-width:0}.mapbox{grid-area:map;min-width:0}
.banner{display:block;width:100%;height:auto;margin:0 0 var(--gap-5);border-radius:var(--edge)}
.readout{display:flex;flex-wrap:wrap;gap:var(--gap-1) var(--gap-4);margin:0;font:var(--size-small)/1.4 var(--font-data);letter-spacing:var(--track-label);text-transform:uppercase;color:var(--dim)}
.readout .warn{color:var(--warn)}.readout .game{color:var(--text)}
h1{margin:var(--gap-2) 0 0;font-size:var(--size-title);line-height:1.08;font-weight:var(--weight-title);letter-spacing:var(--track-title)}
.state{display:flex;align-items:center;gap:var(--gap-2);margin:var(--gap-3) 0 0;font:var(--size-small) var(--font-data);letter-spacing:var(--track-label);text-transform:uppercase;color:var(--dim)}
.state::before{content:"";width:.5rem;height:.5rem;border-radius:50%;background:var(--faint)}
.state.up{color:var(--text)}.state.up::before{background:var(--depth-0);box-shadow:0 0 0 3px rgb(143 233 228 / .18)}
.panel{padding:var(--gap-5);border:var(--hair) solid var(--rule);border-radius:var(--edge);background:var(--hull)}
.steps{margin:0;padding:0;list-style:none;counter-reset:step;display:grid;gap:var(--gap-5)}
.steps.numbered > li{display:grid;grid-template-columns:1.75rem minmax(0,1fr);column-gap:var(--gap-3);counter-increment:step}
.steps.numbered > li::before{content:counter(step);display:grid;place-items:center;width:1.75rem;height:1.75rem;border:var(--hair) solid var(--rule-strong);border-radius:50%;font:600 var(--size-small) var(--font-data);color:var(--dim)}
.steps > li > *{grid-column:2}.steps:not(.numbered) > li > *{grid-column:auto}
.step-title{display:block;margin:.15rem 0 0;font-weight:650}
.path{display:block;margin:var(--gap-1) 0 0;font-size:var(--size-small);color:var(--dim)}.path strong{color:var(--text)}
.lead{margin:0;font-size:var(--size-lead)}
.hint,.fine{margin:var(--gap-3) 0 0;font-size:var(--size-small);color:var(--dim)}
.hint strong{color:var(--text)}
.button{display:flex;justify-content:space-between;align-items:center;min-height:var(--control-height);margin:var(--gap-3) 0 0;padding:0 var(--gap-4);border-radius:var(--edge);background:var(--signal);color:var(--signal-ink);font-weight:700;font-size:var(--size-lead);text-decoration:none}
.steps > li > .button:first-child{margin-top:0}
.button::after{content:"→";font-family:var(--font-data)}
.button:hover{background:var(--signal-hover)}
.button:focus-visible,.full:focus-visible{outline:var(--hair) solid var(--text);outline-offset:var(--focus-offset)}
.button.pressed{opacity:.6}
.get{background:transparent;color:var(--signal);box-shadow:inset 0 0 0 var(--hair) var(--signal)}.get:hover{background:var(--hull-2)}
.actions{display:flex;flex-wrap:wrap;gap:var(--gap-2) var(--gap-5);margin:var(--gap-4) 0 0;padding:var(--gap-4) 0 0;border-top:var(--hair) solid var(--rule);font-size:var(--size-small)}
a{color:var(--link);text-underline-offset:var(--focus-offset)}
.notice{margin:var(--gap-3) 0 0;padding:var(--gap-3) var(--gap-4);border-left:var(--edge) solid var(--link);background:var(--ink);font-size:var(--size-small)}
.notice.warn{border-left-color:var(--warn)}
.notice ol{margin:var(--gap-2) 0 0;padding-left:var(--gap-5)}.notice li{margin:var(--gap-1) 0}
.notice .button{min-height:0;margin:var(--gap-3) 0 0;padding:var(--gap-2) var(--gap-3);font-size:var(--size-body)}
h2,.bar{margin:0;padding:0 0 var(--gap-2);border-bottom:var(--hair) solid var(--rule-strong);font:600 var(--size-small)/1.4 var(--font-data);letter-spacing:var(--track-label);text-transform:uppercase;color:var(--dim)}
.mods{margin:0;padding:0;list-style:none}
.mod{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:baseline;column-gap:var(--gap-3);padding:var(--gap-4) 0;border-bottom:var(--hair) solid var(--rule)}
.mod .top{display:contents}
.mod .name{font-weight:650;grid-column:1}.mod .name a{color:var(--text);text-decoration:none}.mod .name a:hover{color:var(--link);text-decoration:underline}
.mod .facts{grid-column:2;display:flex;flex-wrap:wrap;gap:var(--gap-1) var(--gap-3);align-items:baseline;justify-content:flex-end;font:var(--size-meta) var(--font-data);color:var(--dim)}
.tag{font:600 var(--size-tag) var(--font-data);letter-spacing:var(--track-label);text-transform:uppercase;color:var(--faint)}
.tag.req{color:var(--signal)}
.about{grid-column:1/-1;display:block;margin:var(--gap-1) 0 0;font-size:var(--size-small);color:var(--dim)}
.meta{grid-column:1/-1;display:block;margin:var(--gap-1) 0 0;font:var(--size-meta) var(--font-data);color:var(--faint)}
.close{margin-top:var(--gap-3);padding:var(--gap-2) var(--gap-4);border:var(--hair) solid var(--rule-strong);border-radius:var(--edge);background:transparent;color:var(--dim);font:inherit;cursor:pointer}
.close:hover{color:var(--text);border-color:var(--text)}
.mapbox{display:flex;flex-direction:column;height:min(70vh,36rem)}
.bar{display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--gap-1) var(--gap-4)}
.bar b{font-weight:600;color:var(--text)}
.bar .facts{display:flex;flex-wrap:wrap;gap:0 var(--gap-3);flex:1}.bar .facts span{white-space:nowrap}.bar .facts{font-size:var(--size-meta)}
.full{color:var(--link);text-decoration:none}.full:hover{text-decoration:underline}
.mapbox iframe{flex:1;width:100%;min-height:16rem;margin:var(--gap-3) 0 0;border:var(--hair) solid var(--rule-strong);border-radius:var(--edge);background:var(--hull)}
</style></head>
<body><div class="page{% if map %} with-map{% endif %}">
<header class="head">{% if banner %}<img class="banner" src="{{ banner }}" alt="">{% endif %}<p class="readout"><span class="game">{{ game }}</span>{% if branch %}<span{% if branch != "public" %} class="warn"{% endif %}>{{ branch_label }} branch</span>{% endif %}{% if build %}<span>Build {{ build }}</span>{% endif %}</p><h1>Join {{ world }}</h1><p class="state{% if join %} up{% endif %}">{% if join %}Online{% else %}Starting{% endif %}</p></header>
<main class="act panel"><ol class="steps{% if branch and branch != 'public' %} numbered{% endif %}">
{%- if branch and branch != "public" %}<li><div><span class="step-title">Switch your game to the {{ branch }} branch</span><span class="path">In Steam: Subnautica 2 &rsaquo; Properties &rsaquo; Betas &rsaquo; <strong>{{ branch }}</strong>. The server runs it, so yours must match.</span></div></li>{% endif -%}
<li><div>
{%- if not join %}<p class="lead">The server is starting.</p><p class="hint">This page refreshes itself and is ready as soon as the world is open.</p>
{%- elif mods_published %}{{ mod_action|safe }}
{%- else %}<div id="handoff"><p class="lead" id="lead">Opening Subnautica 2 through Steam…</p><a class="button" href="{{ join }}">Join now</a><p class="hint">Nothing happened? Use the button. Tick <strong>Always allow</strong> on the browser&rsquo;s &ldquo;Open Steam?&rdquo; prompt so later joins take one click.</p><p><button class="close" id="close" type="button" hidden>Close this tab</button></p></div><script>(function(){var c=document.getElementById("close");c.onclick=function(){window.close()};setTimeout(function(){document.getElementById("lead").innerHTML="Launching Subnautica 2 &middot; you can close this tab";c.hidden=false},4000);{% if not map %}document.addEventListener("visibilitychange",function(){if(document.hidden){window.close()}}){% endif %}})()</script>
{%- endif %}</div></li></ol>
{%- if join %}<div class="actions">{% if mods_published %}<a href="{{ join }}">Join without mods</a>{% endif %}<a href="{{ friend }}">{% if mods_published %}Add the host on Steam{% else %}Not friends with the host? Add them on Steam{% endif %}</a></div>{% endif %}</main>
{%- if map %}<section class="mapbox" aria-label="Live map"><p class="bar"><b>Live map</b>{%- if map_facts %}<span class="facts">{% for f in map_facts %}<span>{{ f }}</span>{% endfor %}</span>{% endif %}<a class="full" href="map.html" target="_blank" rel="noopener">Open full map ↗</a></p><iframe src="map.html?embed=1" title="Live map of {{ world }}" loading="lazy"></iframe></section>{% endif %}
{%- if mod_list|trim %}<section class="mods-box">{{ mod_list|safe }}</section>{% endif %}
</div></body></html>
